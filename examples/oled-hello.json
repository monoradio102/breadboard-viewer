{
  "version": 1,
  "title": "I2C OLED に Hello + LED (XIAO ESP32S3)",
  "board": "half",
  "parts": [
    { "id": "U1", "type": "xiao", "at": "d27", "rot": 180, "model": "ESP32S3" },
    { "id": "DISP1", "type": "ssd1306", "at": "j14", "idLabel": false },
    { "id": "L1", "type": "led", "color": "red", "pins": { "A": "a7", "K": "T-7" } },
    { "id": "L2", "type": "led", "color": "yellow", "pins": { "A": "a11", "K": "T-11" } },
    { "id": "L3", "type": "led", "color": "green", "pins": { "A": "a15", "K": "T-15" } },
    { "id": "R1", "type": "resistor", "value": "330", "pins": ["e7", "e10"] },
    { "id": "R2", "type": "resistor", "value": "330", "pins": ["e11", "e14"] },
    { "id": "R3", "type": "resistor", "value": "330", "pins": ["e15", "e18"] }
  ],
  "wires": [
    { "id": "W1", "from": "j25", "to": "B+25", "color": "red", "note": "3V3 → 下の + レール" },
    { "id": "W2", "from": "j26", "to": "B-27", "color": "black", "note": "GND → 下の − レール" },
    { "id": "W3", "from": "T-3", "to": "B-3", "color": "black", "note": "上下の − レールをつなぐ" },
    { "id": "W4", "from": "f15", "to": "B+7", "color": "red", "via": [[8, 11]], "note": "OLED の VCC" },
    { "id": "W5", "from": "g14", "to": "B-9", "color": "black", "via": [[10, 12]], "note": "OLED の GND" },
    { "id": "SCL", "from": "i21", "to": "h16", "color": "yellow", "note": "D7 → SCL" },
    { "id": "SDA", "from": "j22", "to": "i17", "color": "blue", "note": "D8 → SDA" },
    { "id": "W6", "from": "a21", "to": "a18", "color": "green", "note": "D6 → 緑の LED" },
    { "id": "W7", "from": "b22", "to": "b14", "color": "orange", "note": "D5 → 黄の LED" },
    { "id": "W8", "from": "c23", "to": "c10", "color": "purple", "note": "D4 → 赤の LED" }
