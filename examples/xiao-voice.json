{
  "version": 1,
  "title": "XIAO ESP32S3 で音声入出力 (I2S マイク + アンプ)",
  "board": "full",
  "parts": [
    { "id": "U1", "type": "xiao", "at": "h12", "model": "ESP32S3" },
    { "id": "MIC1", "type": "inmp441", "at": "f5" },
    { "id": "AMP1", "type": "max98357a", "at": "a22" },
    { "id": "SP1", "type": "speaker", "pos": [25, -9], "label": "4Ω 3W" },
    { "id": "LED1", "type": "ws2812b", "at": "f33" },
    { "id": "D1", "type": "diode", "model": "1N4007", "pins": { "A": "B+34", "K": "j34" }, "note": "VCC を約 4.3V に下げ、3.3V の信号でも HIGH と判定されるようにする (定番の対策。電圧降下はチェックでは計算していない)" },
    { "id": "DISP1", "type": "ssd1306", "at": "j40" }
  ],
  "wires": [
    { "id": "W1", "from": "a12", "to": "T+12", "color": "red", "note": "5V → 上の + レール (5V)" },
    { "id": "W2", "from": "a13", "to": "T-13", "color": "black", "note": "GND → 上の − レール" },
    { "id": "W3", "from": "T+61", "to": "B+61", "color": "red", "note": "上下の + レールをつなぐ (5V)" },
    { "id": "W4", "from": "T-60", "to": "B-60", "color": "black", "note": "上下の − レールをつなぐ (GND)" },
    { "id": "W5", "from": "a5", "to": "T-5", "color": "black", "note": "マイクの GND" },
    { "id": "W6", "from": "a6", "to": "b14", "color": "orange", "note": "マイクの VDD ← 3V3 (5V にはつながない)" },
    { "id": "SD", "from": "b7", "to": "c15", "color": "blue", "note": "マイクの SD → D10" },
    { "id": "WS", "from": "i12", "to": "i6", "color": "purple", "note": "D0 → マイクの WS" },
    { "id": "SCK", "from": "j13", "to": "j7", "color": "green", "note": "D1 → マイクの SCK" },
    { "id": "W7", "from": "j5", "to": "B-5", "color": "black", "note": "L/R = GND (左チャンネル)" },
    { "id": "W8", "from": "a16", "to": "b22", "color": "purple", "note": "D9 → アンプの LRC" },
    { "id": "W9", "from": "b17", "to": "c23", "color": "green", "note": "D8 → アンプの BCLK" },
    { "id": "DIN", "from": "c18", "to": "d24", "color": "yellow", "note": "D7 → アンプの DIN" },
    { "id": "W10", "from": "d26", "to": "d28", "color": "white", "note": "SD を Vin へ (有効)" },
    { "id": "W11", "from": "b27", "to": "T-30", "color": "black", "via": [[31, 5]], "note": "アンプの GND" },
    { "id": "W12", "from": "c28", "to": "T+31", "color": "red", "via": [[32, 6]], "note": "アンプの Vin ← 5V" },
    { "id": "W13", "from": "AMP1.SPK+", "to": "SP1.+", "color": "red" },
    { "id": "W14", "from": "AMP1.SPK-", "to": "SP1.-", "color": "black" },
    { "id": "W15", "from": "j14", "to": "j33", "color": "brown", "via": [[15, 16], [34, 16]], "note": "D2 → LED1 の DIN (下の溝を通す)" },
    { "id": "W16", "from": "j35", "to": "B-35", "color": "black" },
    { "id": "W17", "from": "f40", "to": "T-40", "color": "black" },
    { "id": "W18", "from": "f41", "to": "T+41", "color": "red" },
    { "id": "W19", "from": "j16", "to": "h43", "color": "blue", "note": "D4 (SDA) → SDA" },
    { "id": "W20", "from": "i17", "to": "g42", "color": "yellow", "note": "D5 (SCL) → SCL" }
  ],
  "animation": {
    "duration": 4000,
    "loop": true,
    "tracks": [
      {
        "target": "DISP1",
        "keys": [
          {
            "t": 0,
            "text": "Listening..."
          },
          {
            "t": 2000,
            "text": "Speaking\nHello!"
          }
        ]
      },
      {
        "target": "LED1",
        "keys": [
          {
            "t": 0,
            "r": 0,
            "g": 0.2,
            "b": 1
          },
          {
            "t": 2000,
            "r": 0,
            "g": 1,
            "b": 0.2
          }
        ]
      },
      {
        "target": "SD",
        "keys": [
          {
            "t": 0,
            "flow": true
          },
          {
            "t": 2000,
            "flow": false
          }
        ]
      },
      {
        "target": "DIN",
        "keys": [
          {
            "t": 0,
            "flow": false
          },
          {
            "t": 2000,
            "flow": true
          }
        ]
      },
      {
        "target": "SP1",
        "keys": [
          {
            "t": 0,
            "on": false
          },
          {
            "t": 2000,
            "on": true
          }
        ]
      }
    ],
    "captions": [
      {
        "t": 0,
        "text": "マイク (INMP441) から I2S で音声を取り込む"
      },
      {
        "t": 2000,
        "text": "アンプ (MAX98357A) へ I2S で送ってスピーカーから再生"
      }
    ]
  }
}
